# Public browser configuration (the Supabase anon key is intentionally public and RLS-limited)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Pages Functions only. Never expose these in browser JavaScript.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:8788
CORS_ALLOWED_ORIGINS=http://localhost:8788
SESSION_COOKIE_NAME=kastiz_session
REFRESH_COOKIE_NAME=kastiz_refresh
CSRF_COOKIE_NAME=kastiz_csrf
GOOGLE_SIGN_IN_ENABLED=false
APPLE_SIGN_IN_ENABLED=false
# Configure OAuth providers inside Supabase Auth first. Do not place OAuth client secrets in frontend code.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
LOG_LEVEL=info
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
APP_ENV=development
UPSTREAM_TIMEOUT_MS=8000
RELEASE_SHA=

# Reserved for future protected provider data. Generate outside source control.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# ONE Pass is opt-in and fails closed. Keep sensitive/real execution flags false until audited staging is complete.
ONE_PASS_ENABLED=false
IDENTITY_VAULT_ENABLED=false
PASSPORT_PERSISTENCE_ENABLED=false
PASSKEY_REAUTH_ENABLED=false
REAL_BOOKING_ENABLED=false
REAL_PAYMENTS_ENABLED=false
IDENTITY_VAULT_PROVIDER=disabled
DEVELOPMENT_VAULT_KEY_BASE64=
PRODUCTION_VAULT_KEY_REFERENCE=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kastiz ONE Local
WEBAUTHN_ORIGIN=http://localhost:8770
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:8770,http://127.0.0.1:8770
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
CBOR_NATIVE_ACCELERATION_DISABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_AGENT_ENABLED=false
OPENAI_STREAMING_ENABLED=false
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_MAX_TOOL_ITERATIONS=8
OPENAI_MAX_RETRIES=1
OPENAI_PROJECT_ID=
OPENAI_GLOBAL_DISABLE=false
OPENAI_MODEL_LIGHTWEIGHT=gpt-5.6-luna
OPENAI_MODEL_STANDARD=gpt-5.6-terra
OPENAI_MODEL_ADVANCED=gpt-5.6-sol
OPENAI_MODEL_SAFETY=gpt-5.6-sol
OPENAI_MAX_INPUT_TOKENS=12000
OPENAI_DAILY_USER_BUDGET_USD=1
OPENAI_MONTHLY_WORKSPACE_BUDGET_USD=25
OPENAI_DUPLICATE_WINDOW_MS=30000
OPENAI_USAGE_ALERT_PERCENT=80
# Pricing must be verified and configured; zero is an unknown-cost safeguard, not a claim that usage is free.
OPENAI_PRICING_EFFECTIVE_DATE=
OPENAI_PRICING_CURRENCY=USD
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
OPENAI_WEB_SEARCH_COST=0
OPENAI_FILE_SEARCH_COST=0
OPENAI_PRICING_VERIFIED_AT=
OPENAI_PRICING_STATUS=UNVERIFIED_CONFIG
ONE_INTELLIGENCE_PROVIDER=OPENAI
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_PRIVACY_REVIEWED=false
GEMINI_DEMO_ENABLED=false

# Live Provider Foundation V1. Keep disabled until Google Cloud keys are created, billed, and restricted.
GOOGLE_PROVIDER_ENABLED=false
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAP_ID=
GOOGLE_PROVIDER_DAILY_QUOTA_LIMIT=250
GOOGLE_PROVIDER_CACHE_TTL_MS=900000
GOOGLE_PROVIDER_TIMEOUT_MS=8000

# Toss Payments test mode only. Never expose TOSS_SECRET_KEY to browser JavaScript.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MODE=test
TOSS_PROVIDER_TIMEOUT_MS=10000

# Future provider integrations. Leave unset until official provider access is approved.
FLIGHT_PROVIDER_ENABLED=false
FLIGHT_PROVIDER_NAME=amadeus
FLIGHT_PROVIDER_ENV=test
FLIGHT_PROVIDER_TIMEOUT_MS=8000
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
ACCOMMODATION_PROVIDER_ENABLED=false
ACCOMMODATION_PROVIDER_NAME=amadeus
HOTEL_PROVIDER_ENV=test
HOTEL_PROVIDER_TIMEOUT_MS=8000
WEATHER_PROVIDER_ENABLED=false
WEATHER_PROVIDER_NAME=open-meteo
WEATHER_PROVIDER_TIMEOUT_MS=8000
EVENT_PROVIDER_ENABLED=false
EVENT_PROVIDER_NAME=
EVENT_PROVIDER_ENV=future
EVENT_PROVIDER_API_KEY=
EXCHANGE_RATE_PROVIDER_ENABLED=false
EXCHANGE_RATE_PROVIDER_NAME=
EXCHANGE_RATE_PROVIDER_ENV=future
EXCHANGE_RATE_PROVIDER_API_KEY=
RESERVATION_PROVIDER_ENABLED=false
RESERVATION_PROVIDER_API_KEY=
